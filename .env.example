# Postgres for the updates list: local in development, Neon in production.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:55432/titan_racers_site"
# Migrations prefer a direct (unpooled) connection when one is set. Neon's
# Vercel integration provides it.
DATABASE_URL_UNPOOLED=""

# SendGrid. Without a key, development prints the confirmation links to the
# server console instead of sending them. Production requires the key.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="no-reply@coopallc.com"
SENDGRID_FROM_NAME="Titan Racers"

# Key for hashing IP addresses in the signup rate limit. Any long random
# string, e.g. `openssl rand -hex 32`. Required in production.
IP_HASH_SECRET=""

# Gets an email for each signup. Leave blank to turn notifications off.
ADMIN_NOTIFY_EMAIL=""

# Origin for links in emails. Production falls back to https://titanracers.com;
# development uses the request's host.
SITE_URL=""
